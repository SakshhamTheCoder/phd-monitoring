<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- The role sweeps call every route as every role in one process, which
             outgrows the CLI's default 128M. -->
        <ini name="memory_limit" value="1G"/>
        <env name="APP_ENV" value="testing"/>
        <!-- The local .env's APP_URL carries a doubled /api path for the
             deployed reverse proxy; without an override here, feature tests
             that hit routes/api.php (which already prefixes /api) resolve
             against that path and 404. Tests only need a plain host. -->
        <env name="APP_URL" value="http://localhost"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- The suite gets its own database. With these commented out it
             inherited DB_DATABASE from .env and ran against the development
             database, so a test using RefreshDatabase wiped real local data.
             sqlite is not an option: 0001_00_00_create_roles_table declares
             increments('id') and primary('id') together, which MySQL tolerates
             and sqlite rejects with "more than one primary key".
             Set it up once:
               CREATE DATABASE phd_monitoring_test
                 CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
               DB_DATABASE=phd_monitoring_test php artisan migrate
               DB_DATABASE=phd_monitoring_test php artisan db:seed
               and then seed TestFixturesSeeder the same way, with db:seed
               and its class option
             RolesSeeder and TestFixturesSeeder together are what the suite needs
             that migrations do not provide. -->
        <env name="DB_DATABASE" value="phd_monitoring_test"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
